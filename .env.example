YANDEX_TTS_URL=https://tts.api.yandexcloud.kz/tts/v3/utteranceSynthesis
YANDEX_TIMEOUT=120
YANDEX_SSL_VERIFY=true
YANDEX_HTTPS_PROXY=
YANDEX_HTTP_PROXY=
