# App
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=*

# Engine selection
DEFAULT_STT_ENGINE=yandex
DEFAULT_TTS_ENGINE=yandex

# Database
DATABASE_URL=postgresql+psycopg2://speech:speech@postgres:5432/speech

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2
CELERY_QUEUE=speech_queue

# File storage (shared volume between API and worker)
UPLOAD_DIR=/app/uploads

# Authentication
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key

# Rate limiting (per API key, fixed window)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Deduplication
DEDUP_ENABLED=true
TTS_CACHE_TTL_SECONDS=86400

# Yandex SpeechKit
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_STT_URL=https://stt.api.yandexcloud.kz/stt/v3/recognizeFileAsync
YANDEX_TTS_URL=https://tts.api.yandexcloud.kz/tts/v3/utteranceSynthesis
YANDEX_TIMEOUT=120
YANDEX_SSL_VERIFY=true
YANDEX_HTTPS_PROXY=
YANDEX_HTTP_PROXY=
