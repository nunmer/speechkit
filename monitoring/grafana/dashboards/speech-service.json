{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Speech Service",
  "tags": ["speech"],
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (by endpoint)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (endpoint) (rate(speech_requests_total[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(speech_requests_total{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(speech_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "Request latency p50/p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(speech_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(speech_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "STT jobs (completed vs failed)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(speech_jobs_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Job processing duration p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(speech_job_duration_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dedup hits & engine errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(speech_dedup_hits_total[5m]))",
          "legendFormat": "dedup {{kind}}"
        },
        {
          "expr": "sum by (operation) (rate(speech_engine_errors_total[5m]))",
          "legendFormat": "error {{operation}}"
        }
      ]
    }
  ]
}
